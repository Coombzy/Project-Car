# Shop API local defaults. Copy to .env — do not commit secrets.

# Local dev only: the placeholder secrets below and /docs boot only with this flag.
SHOP_DEV_MODE=1

DATABASE_URL=postgresql+psycopg://projectcar:projectcar@localhost:5432/projectcar

# v1 Owner session stub (email + password or bearer secret). Not OIDC.
OWNER_EMAIL=owner@projectcar.ca
OWNER_PASSWORD=changeme
OWNER_API_SECRET=dev-owner-secret
AI_API_SECRET=dev-ai-secret
AI_ACTOR_ID=shop-ai
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_SECONDS=86400
COOKIE_NAME=pc_owner_session
MEMBER_COOKIE_NAME=pc_member_session
# Local http — leave false. Public HTTPS (api.projectcar.ca, shop UI via tunnel)
# needs COOKIE_SECURE=true so Firefox will store the session cookie.
COOKIE_SECURE=false

# Demo Member session stub. Email must match a member row. Not OIDC.
MEMBER_DEMO_PASSWORD=changeme

# Header that carries the real client address for the login and waitlist caps.
# Empty: key on the TCP peer. No header name is hard-coded, and X-Forwarded-For
# is rejected. Comma-separated proxy IPs/networks that may set that header.
CLIENT_IP_HEADER=
TRUSTED_PROXIES=
# Shared secret that lets a trusted proxy sign the client-address header.
SHOP_PROXY_SECRET=

# Comma-separated Origin allowlist for browser calls (public POST /waitlist).
# Never use *. ShopCorsMiddleware is always mounted.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://projectcar.ca,https://www.projectcar.ca
# Brochure origins: preflight and POST /waitlist only, never credentialed.
CORS_PUBLIC_ORIGINS=https://projectcar.ca,https://www.projectcar.ca
# Ops, app and local dev origins: full credentialed CORS.
CORS_CREDENTIALED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ops.projectcar.ca,https://app.projectcar.ca

# Feature flag pc.waitlist (platform-architecture.md §5)
PC_WAITLIST=true

# Next-day fill-the-gaps (America/Regina). Not public prices.
FILL_MIN_DISCOUNT_PCT=10
FILL_MAX_DISCOUNT_PCT=25
FILL_DAY_START=08:00
FILL_DAY_END=21:00

# Only "stand-in" is registered. It does not call a processor and applies no fee rate.
PAYMENT_PROCESSOR=stand-in

# Email outbox. Leave SMTP_HOST empty to use the durable stub (records sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=shop@projectcar.ca
SMTP_USE_TLS=true

# Google Calendar OAuth scaffold. Leave empty — Connect Google stays a stub.
# Full two-way sync is Next (Docs/STATUS.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
