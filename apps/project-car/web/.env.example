# Shop API (slice 1). Server-side only — the browser never calls FastAPI directly.
SHOP_API_URL=http://127.0.0.1:8000

# Secure session cookies. Leave unset or false for local http://127.0.0.1:3000.
# Public HTTPS (ops.projectcar.ca / app.projectcar.ca) needs true when KeepAlive
# runs `next dev` (NODE_ENV is not production). Also on when NODE_ENV=production.
# SHOP_COOKIE_SECURE=true
