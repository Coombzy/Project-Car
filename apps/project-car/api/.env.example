# Shop API local defaults. Copy to .env — do not commit secrets.
# local dev only — SHOP_DEV_MODE=1 lets this file boot. Remove that line and
# these placeholders fail startup. Loopback is not a substitute for dev mode.

DATABASE_URL=postgresql+psycopg://projectcar:projectcar@localhost:5432/projectcar

# local dev only
SHOP_DEV_MODE=1

# v1 Owner session stub (email + password or bearer secret). Not OIDC.
# Production: 32+ character secrets and a 12+ character owner password.
OWNER_EMAIL=owner@projectcar.ca
OWNER_PASSWORD=CHANGE_ME
OWNER_API_SECRET=CHANGE_ME_OWNER_API_SECRET
AI_API_SECRET=CHANGE_ME_AI_API_SECRET
SESSION_SECRET=CHANGE_ME_SESSION_SECRET
SESSION_TTL_SECONDS=86400
# local dev only — plain HTTP cannot store a Secure cookie.
# Leave unset in production so the cookie defaults to Secure.
COOKIE_SECURE=false

# Demo Member session stub. Email must match a member row. Not OIDC.
MEMBER_DEMO_PASSWORD=CHANGE_ME

# Shared with the shop UI. Empty disables X-Shop-Client-IP.
# Production sets 32+ characters. Never a short placeholder.
SHOP_PROXY_SECRET=

# Real client IP for login and waitlist caps. The supported value is
# CF-Connecting-IP. X-Forwarded-For is refused. The header is trusted only
# when the TCP peer is listed in TRUSTED_PROXIES (default 127.0.0.1,::1).
CLIENT_IP_HEADER=
TRUSTED_PROXIES=127.0.0.1,::1

# Brochure origins: POST /waitlist only, no credentials.
CORS_PUBLIC_ORIGINS=https://projectcar.ca,https://www.projectcar.ca
# Shop UI origins that may send cookies.
CORS_CREDENTIALED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://ops.projectcar.ca,https://app.projectcar.ca
# Legacy public list, merged into the brochure origins. Never use *.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://projectcar.ca,https://www.projectcar.ca

# Feature flag pc.waitlist (platform-architecture.md §5)
PC_WAITLIST=true

# Next-day fill-the-gaps (America/Regina). Not public prices.
FILL_MIN_DISCOUNT_PCT=10
FILL_MAX_DISCOUNT_PCT=25
FILL_DAY_START=08:00
FILL_DAY_END=21:00

# Email outbox. Leave SMTP_HOST empty to use the durable stub (records sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=shop@projectcar.ca
SMTP_USE_TLS=true

# Google Calendar OAuth scaffold. Leave empty — Connect Google stays a stub.
# Full two-way sync is Next (Docs/STATUS.md).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
