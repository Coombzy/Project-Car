# Shop API local defaults. Copy to .env — do not commit secrets.

DATABASE_URL=postgresql+psycopg://projectcar:projectcar@localhost:5432/projectcar

# v1 Owner session stub (email + password or bearer secret). Not OIDC.
OWNER_EMAIL=owner@projectcar.ca
OWNER_PASSWORD=changeme
OWNER_API_SECRET=dev-owner-secret
SESSION_SECRET=dev-session-secret-change-me
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false

# Comma-separated origins. Empty = no CORS middleware.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Feature flag pc.waitlist (platform-architecture.md §5)
PC_WAITLIST=true
